<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeatherDashboard.ViewModels"
        x:Class="WeatherDashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Weather Dashboard"
        Width="1000"
        Height="720"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

            <TextBlock Grid.Column="0"
                       Text="Weather Dashboard"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Height="36"
                    Padding="16,6"
                    Command="{Binding RefreshCommand}"/>

        </Grid>

        <!-- Admin panel -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsAdmin}"
                Background="#FBF3EA"
                BorderBrush="#B08968"
                BorderThickness="1"
                Padding="10"
                Margin="0,12,0,0"
                CornerRadius="6">

            <StackPanel Orientation="Horizontal"
                        Spacing="12">

                <TextBlock Text="Admin panel:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Clear cached data"
                        Command="{Binding ClearCacheCommand}"/>

            </StackPanel>

        </Border>

        <!-- Error message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,8"/>

        <!-- Main content: location sidebar + forecast -->
        <Grid ColumnDefinitions="190,*">
              

            <!-- Location sidebar -->
            <Border Grid.Column="0"
                    Background="#F4F7FB"
                    BorderBrush="#D6DCE5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Top"
                                Spacing="5"
                                Margin="0,0,0,12">

                        <TextBlock Text="LOCATIONS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#202938"/>

                        <TextBlock Text="Select a location"
                                   FontSize="11"
                                   Foreground="#667085"/>

                    </StackPanel>

                    <ListBox ItemsSource="{Binding Locations}"
                             SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Padding="10,12"
                                        CornerRadius="6"
                                        Margin="0,2">

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </DockPanel>

            </Border>

            <!-- Weather content -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*">
                  

                <!-- Forecast cards -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D6DCE5"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Weather Forecast"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#202938"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding ForecastDays}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Background="#FAFAFA"
                                                BorderBrush="#D6DCE5"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Width="115">

                                            <StackPanel Spacing="6">

                                                <TextBlock Text="{Binding DayLabel}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"/>

                                                <TextBlock Text="{Binding MaxTemp, StringFormat='{}{0:0}°'}"
                                                           FontSize="23"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#C75D22"/>

                                                <TextBlock Text="{Binding MinTemp, StringFormat='Low: {0:0}°'}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#2475B9"
                                                           FontSize="12"/>

                                                <TextBlock Text="{Binding RainProbability, StringFormat='Rain: {0:0}%'}"
                                                           Foreground="#2E6F6F"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </StackPanel>

                </Border>

                <!-- Temperature chart -->
                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#D6DCE5"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">

                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- Chart heading -->
                        <StackPanel Grid.Row="0"
                                    Spacing="4"
                                    Margin="0,0,0,12">

                            <TextBlock Text="7-Day Temperature Forecast"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#202938"/>

                            <TextBlock Text="Daily minimum and maximum temperatures"
                                       FontSize="12"
                                       Foreground="#666666"/>

                        </StackPanel>

                        <!-- Chart legend -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    Margin="0,0,0,12">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">

                                <Rectangle Width="12"
                                           Height="12"
                                           Fill="#3995E5"
                                           RadiusX="3"
                                           RadiusY="3"/>

                                <TextBlock Text="Minimum temperature"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">

                                <Rectangle Width="12"
                                           Height="12"
                                           Fill="#E98245"
                                           RadiusX="3"
                                           RadiusY="3"/>

                                <TextBlock Text="Maximum temperature"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- Temperature bars -->
                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding ForecastDays}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Width="76"
                                              Height="230"
                                              RowDefinitions="Auto,*,Auto">

                                            <!-- Temperature labels -->
                                            <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="4">

                                                <TextBlock Text="{Binding MinTemp, StringFormat='{}{0:0}°'}"
                                                           FontSize="10"
                                                           Foreground="#2475B9"/>

                                                <TextBlock Text="{Binding MaxTemp, StringFormat='{}{0:0}°'}"
                                                           FontSize="10"
                                                           Foreground="#C75D22"/>

                                            </StackPanel>

                                            <!-- Temperature bars -->
                                            <Grid Grid.Row="1"
                                                  Height="180"
                                                  VerticalAlignment="Bottom">

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom"
                                                            Spacing="5">

                                                    <Rectangle Width="22"
                                                               Height="{Binding MinTempBarHeight}"
                                                               Fill="#3995E5"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               VerticalAlignment="Bottom"/>

                                                    <Rectangle Width="22"
                                                               Height="{Binding MaxTempBarHeight}"
                                                               Fill="#E98245"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               VerticalAlignment="Bottom"/>

                                                </StackPanel>

                                            </Grid>

                                            <!-- Day label -->
                                            <Border Grid.Row="2"
                                                    Background="#F2F5F9"
                                                    CornerRadius="5"
                                                    Padding="4"
                                                    Margin="0,6,0,0">

                                                <TextBlock Text="{Binding DayLabel}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#374151"/>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </DockPanel>

</Window>