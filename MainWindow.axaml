<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeatherDashboard.ViewModels"
        x:Class="WeatherDashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Weather Dashboard"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,0,0,16">

            <TextBlock Grid.Column="0"
                       Text="Weather Dashboard"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- Location selector -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">

                <TextBlock Text="Location:"
                           VerticalAlignment="Center"
                           FontSize="13"/>

                <ComboBox   Grid.Column="1"
                            Width="200"
                            Height="36"
                            ItemsSource="{Binding TestLocations}"
                            SelectedIndex="0"/>

            </StackPanel>

            <!-- Refresh button -->
            <Button Grid.Column="2"
                    Content="Refresh"
                    Height="36"
                    Margin="10,0,0,0"
                    Padding="14,6"
                    Command="{Binding RefreshCommand}"/>

        </Grid>

        <!-- Admin panel -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsAdmin}"
                Background="#FBF3EA"
                BorderBrush="#B08968"
                BorderThickness="1"
                Padding="10"
                Margin="0,12,0,0"
                CornerRadius="6">

            <StackPanel Orientation="Horizontal"
                        Spacing="12">

                <TextBlock Text="Admin panel:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Clear cached data"
                        Command="{Binding ClearCacheCommand}"/>

            </StackPanel>

        </Border>

        <!-- Error message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,8"/>

        <!-- Forecast cards -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,16">

            <ItemsControl ItemsSource="{Binding ForecastDays}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#FAFAFA"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Width="120">

                            <StackPanel Spacing="6">

                                <TextBlock Text="{Binding DayLabel}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding MaxTemp, StringFormat='{}{0:0}°'}"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="#C75D22"/>

                                <TextBlock Text="{Binding MinTemp, StringFormat='Low: {0:0}°'}"
                                           HorizontalAlignment="Center"
                                           Foreground="#2475B9"/>

                                <TextBlock Text="{Binding RainProbability, StringFormat='Rain: {0:0}%'}"
                                           Foreground="#2E6F6F"
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- Temperature comparison chart -->
        <Border Background="#FFFFFF"
                BorderBrush="#D6DCE5"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Chart heading -->
                <StackPanel Grid.Row="0"
                            Spacing="4"
                            Margin="0,0,0,12">

                    <TextBlock Text="7-Day Temperature Forecast"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#202938"/>

                    <TextBlock Text="Daily minimum and maximum temperatures"
                               FontSize="12"
                               Foreground="#666666"/>

                </StackPanel>

                <!-- Chart legend -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            Margin="0,0,0,12">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <Rectangle Width="12"
                                   Height="12"
                                   Fill="#3995E5"
                                   RadiusX="3"
                                   RadiusY="3"/>

                        <TextBlock Text="Minimum temperature"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <Rectangle Width="12"
                                   Height="12"
                                   Fill="#E98245"
                                   RadiusX="3"
                                   RadiusY="3"/>

                        <TextBlock Text="Maximum temperature"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

                <!-- Temperature bars -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding ForecastDays}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Grid Width="76"
                                      Height="230"
                                      RowDefinitions="Auto,*,Auto">

                                    <!-- Temperature labels -->
                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="4">

                                        <TextBlock Text="{Binding MinTemp, StringFormat='{}{0:0}°'}"
                                                   FontSize="10"
                                                   Foreground="#2475B9"/>

                                        <TextBlock Text="{Binding MaxTemp, StringFormat='{}{0:0}°'}"
                                                   FontSize="10"
                                                   Foreground="#C75D22"/>

                                    </StackPanel>

                                    <!-- Temperature bars -->
                                    <Grid Grid.Row="1"
                                          Height="180"
                                          VerticalAlignment="Bottom">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Spacing="5">

                                            <Rectangle Width="22"
                                                       Height="{Binding MinTempBarHeight}"
                                                       Fill="#3995E5"
                                                       RadiusX="4"
                                                       RadiusY="4"
                                                       VerticalAlignment="Bottom"/>

                                            <Rectangle Width="22"
                                                       Height="{Binding MaxTempBarHeight}"
                                                       Fill="#E98245"
                                                       RadiusX="4"
                                                       RadiusY="4"
                                                       VerticalAlignment="Bottom"/>

                                        </StackPanel>

                                    </Grid>

                                    <!-- Day label -->
                                    <Border Grid.Row="2"
                                            Background="#F2F5F9"
                                            CornerRadius="5"
                                            Padding="4"
                                            Margin="0,6,0,0">

                                        <TextBlock Text="{Binding DayLabel}"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="#374151"/>

                                    </Border>

                                </Grid>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </DockPanel>

</Window>